# Incluído no ~/.gitconfig pelo install.sh (include.path).
# user.name / user.email ficam no ~/.gitconfig de cada máquina.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictStyle = zdiff3

[init]
	defaultBranch = main

[push]
	autoSetupRemote = true
